      device = "/dev/disk/by-uuid/4f7b47fa-cc1d-48bf-99de-deae23189c52";
      fsType = "ext4";
    };

    "/boot" = {
      device = "/dev/disk/by-uuid/AF32-3F06";
      fsType = "vfat";
    };

    "/media/exthd-a" = {
      device = "/dev/mapper/luks_exthd_a";
      fsType = "ext4";
      options = [
        "noauto"
        "x-systemd.requires=systemd-cryptsetup@luks_exthd_a.service"
      ];
    };

    "/media/exthd-b" = {
      device = "/dev/mapper/luks_exthd_b";
      fsType = "ext4";
      options = [
        "noauto"
        "x-systemd.requires=systemd-cryptsetup@luks_exthd_b.service"
      ];
    };
  };

  swapDevices = [];

  powerManagement.cpuFreqGovernor = lib.mkDefault "powersave";

  services.udev.extraRules = ''
    # external hard drives
    ACTION=="add", ENV{ID_FS_UUID}=="1ae179bf-23ae-4ee1-a839-01cf3800583a", ENV{SYSTEMD_WANTS}="media-exthd\\x2da.mount"
    ACTION=="add", ENV{ID_FS_UUID}=="3d7e2725-9a7d-42a9-824f-8515402788a4", ENV{SYSTEMD_WANTS}="media-exthd\\x2db.mount"
