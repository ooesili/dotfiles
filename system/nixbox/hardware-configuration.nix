{
  lib,
  modulesPath,
  ...
}: {
  imports = [
    (modulesPath + "/installer/scan/not-detected.nix")
  ];

  boot.extraModulePackages = [];
  boot.initrd.availableKernelModules = [
    "xhci_pci"
    "ahci"
    "nvme"
    "usbhid"
    "uas"
    "sd_mod"
    "aesni_intel"
    "cryptd"
  ];
  boot.initrd.kernelModules = ["dm-snapshot"];
  boot.initrd.luks.devices."root-crypt" = {
    device = "/dev/disk/by-uuid/fc02466e-e37e-4965-a2f3-80302b2b9a21";
  };
  boot.kernelModules = ["kvm-intel"];

  environment.etc."crypttab".text = ''
    luks_exthd_a UUID=1ae179bf-23ae-4ee1-a839-01cf3800583a /etc/secrets/luks-keys/exthd-crypt luks,noauto
    luks_exthd_b UUID=3d7e2725-9a7d-42a9-824f-8515402788a4 /etc/secrets/luks-keys/exthd-crypt luks,noauto
  '';

  fileSystems = {
